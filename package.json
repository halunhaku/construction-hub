{
  "name": "construction-management-platform",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "统一施工管理平台：项目台账、三阶段影像与高速公路作业区布置",
  "scripts": {
    "dev": "vite",
    "dev:api": "wrangler pages dev dist --port 8788",
    "build": "tsc -b && tsc -p functions/tsconfig.json && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "db:init": "wrangler d1 execute three-photos-db --file=schema.sql",
    "db:migrate:excel": "wrangler d1 execute three-photos-db --local --file=migrations/0002_excel_import_fields.sql",
    "db:migrate:excel:remote": "wrangler d1 execute three-photos-db --remote --file=migrations/0002_excel_import_fields.sql",
    "deploy": "npm run build && wrangler pages deploy dist --project-name construction-hub"
  },
  "dependencies": {
    "hono": "^4.13.0",
    "jszip": "^3.10.1",
    "lucide-react": "^1.28.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260804.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "oxlint": "^1.75.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "wrangler": "^4.118.0"
  },
  "allowScripts": {
    "workerd@1.20260730.1": true,
    "esbuild@0.28.1": true
  }
}
